{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Dashboard": {
    "Namespace": "game-servers",
    "SecretName": "game-secrets",
    "BindAddress": "127.0.0.1",
    "Port": 5000,
    "RequireAuthWhenExposed": true,
    "AutoScale": {
      "Enabled": true,
      "IntervalSeconds": 30,
      "MemoryHighWaterPercent": 80
    },
    "Metrics": {
      "PushIntervalSeconds": 5
    }
  }
}
